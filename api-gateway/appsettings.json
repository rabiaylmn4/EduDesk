{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
        // Giriş ve Kayıt olurken bilet aranmaz (Herkese açık kapı)
      },
      "tickets-route": {
        "ClusterId": "support-cluster",
        "Match": {
          "Path": "/api/tickets/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
        // ÇÖK KRİTİK: Destek biletlerine erişmek için artık Token (Bilet) ZORUNLU!
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "support-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}